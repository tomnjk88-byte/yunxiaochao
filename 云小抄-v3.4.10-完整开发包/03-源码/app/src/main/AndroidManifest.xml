<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- 悬浮窗：需用户在系统设置里手动授予「显示在其他应用上层」 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Android 14+ 前台服务类型 specialUse（悬浮窗常驻） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16 实时更新（OPPO ColorOS 16 流体云按此规范接入）：把下载进度提升为「进行中」通知 -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 下载调试：读取当前网络类型 / 是否计费 / 链路速率估计（普通权限，安装即授予，无运行时弹窗；
         蜂窝代际 5G/4G 与真正的信号强度还需要 READ_PHONE_STATE / ACCESS_WIFI_STATE 等权限，
         本项目不申请，日志里只记「未区分」，改用系统给的链路速率估计当网络质量指标） -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 锁屏保持下载：息屏时维持 Wi-Fi/CPU，避免长时间下载断连 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 锁屏保持下载：允许引导用户将应用加入「忽略电池优化」白名单 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- APK 安装：Android 8+ 检查「安装未知来源应用」权限需要 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 9- 写公共 Download 目录需要（10 走 MediaStore，legacy 模式回退也需要） -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <!-- 内置下载引擎（Gopeed）只能按真实文件系统路径写文件：Android 11+ 要写公共 Download 目录
         就得有「所有文件访问」。低版本不需要（9- 用上面的 WRITE_EXTERNAL_STORAGE，
         10 由 application 的 requestLegacyExternalStorage 回到旧模式 + 同一运行时权限）。
         用户需在系统设置里手动开启，PermissionState.allFilesAccessGranted 判断，
         不给也能用——引擎会自动退到应用外部私有目录（见 Agent.md §3.29）。 -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:name=".YunXApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/Theme.ComposeEmptyActivity">

        <!-- ★ launchMode=singleTask：深链接（分享链接一键唤起）必须复用同一个实例，
             否则从浏览器点链接会再起一个 MainActivity（两个任务两套状态）。
             深链接 intent 由 onNewIntent 送达（见 MainActivity.handleDeepLink）。
             ★ v2.5.4：独立 taskAffinity —— 完整解析器（云析原版界面）必须待在自己的任务里。
             之前它和桌面入口共用一个任务，从「解析」页跳过去之后，再点桌面图标
             launcher 会把整个任务提到前台，最上面那页仍是云析界面，看起来就是
             「一打开就跳到云析去了，回不到小抄」。分任务后：点图标永远回小抄首页，
             解析器按返回键退回小抄。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.yunx.app.parser"
            android:theme="@style/Theme.ComposeEmptyActivity" />

        <!-- ==================== 云小抄（基于云析二次开发，AGPL-3.0） ====================
             ★ v2.5.5：桌面入口必须单开任务栈（taskAffinity=com.yunx.app.guide.home）。
             之前它和深链接 alias（云析完整解析器）共用默认任务：从「解析」页跳进云析、
             或点网盘链接唤起云析后，整个任务被云析界面压在栈顶；再点桌面图标，
             launcher 只是把任务提到前台，最上面那页仍是云析 —— 用户看到的就是
             「一打开就是云析界面，不是小抄」。分栈后：点图标永远回小抄首页。 -->
        <activity
            android:name=".overlay.MainActivityIcon2"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.yunx.app.guide.home"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/app_name"
            android:theme="@style/Theme.YunXiaoChao">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".overlay.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.yunx.app.guide.home"
            android:label="@string/app_name"
            android:theme="@style/Theme.YunXiaoChao" />

        <!-- v1.8.4：连招「专属按键」换图片的中继 Activity。
             全透明、不进最近任务；因为连招面板挂在 Service 悬浮窗里，没有
             ActivityResultRegistryOwner，选图必须借一个真实 Activity 发起。 -->
        <activity
            android:name=".overlay.MacroIconPickerActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.TransparentPicker" />

        <!-- v1.9.15：连招分享的「接住」入口。
             从微信 / QQ / 文件管理器点开 .yxmacro，或把口令文本分享到本 App，
             都会落到这里：透明无界面，导完 Toast 一句就退出，不需要用户先开 App。
             ★ ACTION_VIEW 收 octet-stream 是必须的：微信收到未知后缀（.yxmacro）时
               就是按 octet-stream 调「用其他应用打开」，不收这条，对方在微信里根本
               看不到云小抄。APK / zip 有各自的精确 MIME，不会被这条匹配；真正会落到
               这里的是「后缀不认识的文件」，正好是我们要接的场景。
             ★ 内容不对时 Activity 只弹一句提示就退，不会误导入。 -->
        <activity
            android:name=".overlay.macro.MacroImportActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:label="导入连招到云小抄"
            android:theme="@style/Theme.TransparentPicker">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:mimeType="application/vnd.yunx.macro+json" />
                <data android:scheme="file" android:mimeType="application/vnd.yunx.macro+json" />
                <data android:scheme="content" android:mimeType="application/octet-stream" />
                <data android:scheme="file" android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.yunx.macro+json" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/json" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity
            android:name=".overlay.login.QuarkLoginActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.ComposeEmptyActivity" />

        <activity
            android:name=".overlay.login.XunleiLoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.ComposeEmptyActivity" />

        <service
            android:name=".overlay.service.FloatingService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="floating_overlay_for_personal_cloud_drive_guide_images" />
        </service>

        <!-- 自动连招：Android 7.0+ 的无障碍手势注入，不需要 root -->
        <service
            android:name=".overlay.macro.MacroAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- ============================ 深链接（按平台注册，可在设置里逐个关掉） ============================
             为什么要用 activity-alias 而不是直接写在 MainActivity 上：清单里的 intent-filter 无法在运行时修改，
             要让用户能在设置里改「哪些链接由云析接管」，只能把每种链接挂到独立的 alias 上，
             再用 PackageManager.setComponentEnabledSetting 启停（与桌面动态图标同一套机制，见 ThemeScreen）。
             ★ 这些 alias 的类名必须与 data/prefs/LinkOpenTarget.kt 里的 alias 常量逐字一致。
             ★ 一律不开 autoVerify：pan.quark.cn / pan.baidu.com 这些域名不是我们的，放不了 assetlinks.json，
               校验失败反而会被系统排除掉；不开校验就是普通深链接——首次点链接弹「打开方式」，选云析后可设默认。
             ★ 只注册 ShareLinkParser 真正认得的 URL 形态（路径前缀与解析正则对齐），避免抢走处理不了的链接。 -->

        <!-- 夸克网盘：pan.quark.cn/s/xxx -->
        <activity-alias
            android:name="com.yunx.app.link.QuarkLink"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ComposeEmptyActivity"
            android:taskAffinity="com.yunx.app.parser"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="pan.quark.cn" android:pathPrefix="/s/" />
            </intent-filter>
        </activity-alias>

        <!-- UC 网盘：drive.uc.cn/s/xxx -->
        <activity-alias
            android:name="com.yunx.app.link.UcLink"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ComposeEmptyActivity"
            android:taskAffinity="com.yunx.app.parser"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="drive.uc.cn" android:pathPrefix="/s/" />
            </intent-filter>
        </activity-alias>

        <!-- 迅雷网盘：pan.xunlei.com/s/xxx -->
        <activity-alias
            android:name="com.yunx.app.link.XunleiLink"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ComposeEmptyActivity"
            android:taskAffinity="com.yunx.app.parser"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="pan.xunlei.com" android:pathPrefix="/s/" />
            </intent-filter>
        </activity-alias>

        <!-- 百度网盘：pan.baidu.com/s/1xxx -->
        <activity-alias
            android:name="com.yunx.app.link.BaiduLink"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ComposeEmptyActivity"
            android:taskAffinity="com.yunx.app.parser"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="pan.baidu.com" android:pathPrefix="/s/" />
            </intent-filter>
        </activity-alias>

        <!-- 139（和彩云）：yun.139.com/shareweb/.../w/i/xxx -->
        <activity-alias
            android:name="com.yunx.app.link.C139Link"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ComposeEmptyActivity"
            android:taskAffinity="com.yunx.app.parser"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="yun.139.com" android:pathPrefix="/shareweb/" />
            </intent-filter>
        </activity-alias>

        <!-- 123 云盘：www.123pan.com/s/xxx、www.123865.com/s/xxx、www.123pan.cn/s/xxx、<UID>.share.123pan.cn/123pan/xxx
             四种形态路径规则不同，必须一个 <data> 一条 intent-filter —— 同一 filter 内的多条 <data> 会被
             并成「scheme/host/path 三个集合求交」，路径会串到别的 host 上。 -->
        <activity-alias
            android:name="com.yunx.app.link.Pan123Link"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ComposeEmptyActivity"
            android:taskAffinity="com.yunx.app.parser"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="www.123pan.com" android:pathPrefix="/s/" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="www.123865.com" android:pathPrefix="/s/" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="www.123pan.cn" android:pathPrefix="/s/" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="share.123pan.cn" android:pathPrefix="/123pan/" />
                <data android:scheme="https" android:host="*.share.123pan.cn" android:pathPrefix="/123pan/" />
            </intent-filter>
        </activity-alias>

        <!-- 115 网盘：115.com/s/<code>、以及口令形态 115.com/<code>-<提取码>/（code 以 sw 开头） -->
        <activity-alias
            android:name="com.yunx.app.link.Pan115Link"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ComposeEmptyActivity"
            android:taskAffinity="com.yunx.app.parser"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="115.com" android:pathPrefix="/s/" />
                <data android:scheme="https" android:host="115cdn.com" android:pathPrefix="/s/" />
                <data android:scheme="https" android:host="115rc.com" android:pathPrefix="/s/" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- 口令形态：路径以 /sw 开头（分隔符用 pathPrefix 而不是 pathPattern：
                     pathPattern 是 SIMPLE_GLOB，`*` 表示「重复前一个字符」而不是任意串，/sw* 匹配不到 /sws8xxx） -->
                <data android:scheme="https" android:host="115.com" android:pathPrefix="/sw" />
                <data android:scheme="https" android:host="115cdn.com" android:pathPrefix="/sw" />
                <data android:scheme="https" android:host="115rc.com" android:pathPrefix="/sw" />
            </intent-filter>
        </activity-alias>

        <!-- 光鸭云盘：www.guangyapan.com/s/xxx -->
        <activity-alias
            android:name="com.yunx.app.link.GuangyaLink"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ComposeEmptyActivity"
            android:taskAffinity="com.yunx.app.parser"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="www.guangyapan.com" android:pathPrefix="/s/" />
            </intent-filter>
        </activity-alias>

        <!-- 蓝奏云：域名族 lanzou* 的 a-z 轮换域名 + lanzn.com（2026-10 起的新族，issue #197）。
             bare 与 *. 两种写法都要列，清单通配符只能匹配最左一级。
