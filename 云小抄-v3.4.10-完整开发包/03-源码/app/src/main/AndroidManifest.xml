                <data android:scheme="https" android:host="lanzouy.com" />
                <data android:scheme="https" android:host="*.lanzouy.com" />
                <data android:scheme="https" android:host="lanzouz.com" />
                <data android:scheme="https" android:host="*.lanzouz.com" />
                <!-- 新域名族 lanzn（issue #197：https://<用户子域>.lanzn.com/<shareId>）：
                     ShareLinkParser 已认（见 lanzouShareIdRegex），这里不列就只有「粘贴能解析、点链接却打不开」 -->
                <data android:scheme="https" android:host="lanzn.com" />
                <data android:scheme="https" android:host="*.lanzn.com" />
                <data android:scheme="https" android:host="ilanzou.com" android:pathPrefix="/s/" />
                <data android:scheme="https" android:host="ilanzou.net" android:pathPrefix="/s/" />
                <data android:scheme="https" android:host="ilanzou.org" android:pathPrefix="/s/" />
                <data android:scheme="https" android:host="ilanzou.cn" android:pathPrefix="/s/" />
            </intent-filter>
        </activity-alias>

        <!-- 磁力链接：magnet:?xt=urn:btih:...（只有 Gopeed 引擎能下，进下载页的「添加下载任务」弹窗预填） -->
        <activity-alias
            android:name="com.yunx.app.link.MagnetLink"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ComposeEmptyActivity"
            android:taskAffinity="com.yunx.app.parser"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="magnet" />
            </intent-filter>
        </activity-alias>

        <!-- 自有协议：yunx://resolve?url=<encode 后的分享链接>&pwd=xxxx
             用于其它 App/网页/二维码精确拉起（不受上面域名白名单限制，也是蓝奏云那些列不全的域名的兜底） -->
        <activity-alias
            android:name="com.yunx.app.link.YunxLink"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ComposeEmptyActivity"
            android:taskAffinity="com.yunx.app.parser"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="yunx" />
            </intent-filter>
        </activity-alias>

        <!-- 分享到云析：在别的 App 里「分享 → 云析」（文本 / 口令 / 分享链接都收） -->
        <activity-alias
            android:name="com.yunx.app.link.ShareLink"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ComposeEmptyActivity"
            android:taskAffinity="com.yunx.app.parser"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>

        <!-- 选中文本解析：长按选中一段文字后，系统文本选择菜单（三点 → 更多）里出现「用云析解析」。
             这是安卓官方的「把选中文本交给第三方 App 处理」入口（PROCESS_TEXT），不需要 ROM 白名单，
             也是系统侧那些「复制口令后推荐打开某 App」能力在标准安卓上唯一可由第三方占据的位置。
             label 单独用一个字符串：菜单里显示成「用云析解析」比光秃秃一个「云析」清楚。 -->
        <activity-alias
            android:name="com.yunx.app.link.ProcessTextLink"
            android:exported="true"
            android:label="@string/process_text_action"
            android:theme="@style/Theme.ComposeEmptyActivity"
            android:taskAffinity="com.yunx.app.parser"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>

        <!-- 桌面图标动态切换（新图标）：默认禁用，主题与外观页切换后经 setComponentEnabledSetting 启用。
             图标走 @drawable/ic_launcher_new：API 26+ 为自适应图标（drawable-v26），API 24-25 为位图回退。
             roundIcon 必须一并声明：部分启动器优先取 roundIcon，缺省会回落到 application 的经典图标。
             ★ v2.5.5：targetActivity 从云析 .MainActivity 改成云小抄 .overlay.MainActivity。
             之前这个 alias 指向云析主界面 —— 用户一切「新图标」，桌面入口就直接开云析，
               「打开是云析界面」就是这么来的。现在两个图标变体都进云小抄，只是换张皮。
             target 选 .overlay.MainActivity（永不禁用的真实页面）而不是 .overlay.MainActivityIcon2，
             是因为切图标时会禁用另一个入口组件 —— target 跟着被禁，alias 就起不来了。 -->
        <activity-alias
            android:name=".MainActivityIcon2"
            android:enabled="false"
            android:exported="true"
            android:launchMode="singleTask"
            android:icon="@drawable/ic_launcher_new"
            android:roundIcon="@drawable/ic_launcher_new"
            android:label="@string/app_name"
            android:taskAffinity="com.yunx.app.guide.home"
            android:targetActivity=".overlay.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 桌面图标（第 3 套：圆形）—— 与上面 `.MainActivityIcon2` 同一套机制：
             四个入口互斥，同一时刻只启用一个，桌面永远只看到一个图标。
             ★ 类名必须以 MainActivityIcon2 结尾：YunXApp 的防改包校验会检查
               getLaunchIntentForPackage() 返回的组件名，不匹配会直接杀进程。
               alias 的 name 就是它的组件名，所以这里用 `iconround.MainActivityIcon2` 这种形式。 -->
        <activity-alias
            android:name="com.yunx.app.iconround.MainActivityIcon2"
            android:enabled="false"
            android:exported="true"
            android:launchMode="singleTask"
            android:icon="@mipmap/ic_launcher_round"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/app_name"
            android:taskAffinity="com.yunx.app.guide.home"
            android:targetActivity=".overlay.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 桌面图标（第 4 套：手绘款） -->
        <activity-alias
            android:name="com.yunx.app.iconphoto.MainActivityIcon2"
            android:enabled="false"
            android:exported="true"
            android:launchMode="singleTask"
            android:icon="@drawable/icon2"
            android:roundIcon="@drawable/icon2"
            android:label="@string/app_name"
            android:taskAffinity="com.yunx.app.guide.home"
            android:targetActivity=".overlay.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 崩溃界面：独立进程运行，避免主线程崩溃后无法展示 UI -->
        <activity
            android:name=".crash.CrashActivity"
            android:exported="false"
            android:process=":crash"
            android:theme="@style/Theme.ComposeEmptyActivity" />

        <!-- 下载前台服务：下载中保持前台，避免后台限速/进程被杀 -->
        <service
            android:name=".data.download.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 文件共享：导出日志等场景（ACTION_SEND 分享） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <provider
            android:name=".LaunchGate"
            android:authorities="${applicationId}.launchgate"
            android:exported="false" />

        <!-- v3.2.0：Shizuku 客户端入口。Shizuku 服务通过这个 provider 找到本应用，
             授予「以 shell 身份执行命令」的权限 —— 连招靠它做独立指针注入（不打断摇杆）。 -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

    </application>

</manifest>
